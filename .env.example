# =============================================================================
# Template de Site Imobiliário — Variáveis de Ambiente
# Copie para .env.local e preencha. NUNCA commite .env.local.
# Regra: NEXT_PUBLIC_* vai para o browser. Sem prefixo = SERVIDOR APENAS.
# =============================================================================

# --- Supabase (projeto DEDICADO deste cliente — nunca reaproveitar o de outro) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ATENÇÃO: bypassa RLS. Só em Server Components / Route Handlers. Nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Contato / conversão ---
# Somente dígitos, com DDI. Ex.: 5581999416438
NEXT_PUBLIC_WHATSAPP_NUMERO=5500000000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_CRECI=00000-X

# --- Identidade do cliente (opcional — senão usa os defaults em src/lib/site-config.ts) ---
NEXT_PUBLIC_SITE_NOME="Sua Imobiliária"
NEXT_PUBLIC_SITE_NOME_CURTO="Imobiliária"
NEXT_PUBLIC_ATUACAO="sua região"
NEXT_PUBLIC_INSTAGRAM_HANDLE="@sua_imobiliaria"
