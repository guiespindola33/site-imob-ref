# =============================================================================
# Vertiz Soluções Imobiliárias — Variáveis de Ambiente
# Copie para .env.local e preencha. NUNCA commite .env.local.
# Regra: NEXT_PUBLIC_* vai para o browser. Sem prefixo = SERVIDOR APENAS.
# =============================================================================

# --- Supabase (projeto DEDICADO da Vertiz — nunca reaproveitar o da ABE) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ATENÇÃO: bypassa RLS. Só em Server Components / Route Handlers. Nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Contato / conversão ---
# Somente dígitos, com DDI. Ex.: 5581999416438
NEXT_PUBLIC_WHATSAPP_NUMERO=5581999416438
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/vertizsolucoes
NEXT_PUBLIC_CRECI=21669-J
